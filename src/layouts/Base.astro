---
import '../styles/global.css';
import type { Client } from '../lib/clients';
import { withBase, imageUrl, onAccent } from '../lib/clients';
import Ambient from '../components/Ambient.astro';

interface Props {
  client: Client;
}
const { client } = Astro.props;
const { seo, theme, business, hero } = client;
const style = client.style ?? 'calm';

const accent = theme?.accent ?? '#f2690a';
const themeStyle = [
  theme?.accent ? `--color-hivis:${theme.accent}` : '',
  theme?.dark ? `--color-graphite:${theme.dark}` : '',
  `--color-on-accent:${onAccent(accent)}`,
]
  .filter(Boolean)
  .join(';');

const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': seo.schemaType ?? 'LocalBusiness',
  name: business.name,
  description: seo.description,
  telephone: business.phone,
  url: canonical,
  image: imageUrl(hero.image, 1200),
  ...(business.address
    ? {
        address: {
          '@type': 'PostalAddress',
          streetAddress: business.address,
          addressLocality: 'София',
          addressCountry: 'BG',
        },
      }
    : {}),
  ...(seo.geo ? { geo: { '@type': 'GeoCoordinates', latitude: seo.geo.lat, longitude: seo.geo.lng } } : {}),
  ...(business.areas?.length
    ? { areaServed: business.areas.map((name) => ({ '@type': 'Place', name: `${name}, София` })) }
    : {}),
  ...(seo.openingHours?.length ? { openingHours: seo.openingHours } : {}),
  ...(seo.priceRange ? { priceRange: seo.priceRange } : {}),
  ...(seo.sameAs?.length ? { sameAs: seo.sameAs } : {}),
  ...(client.services?.length
    ? {
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: 'Услуги',
          itemListElement: client.services.map((s) => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: s.title, description: s.text },
          })),
        },
      }
    : {}),
  ...(business.rating && business.reviewCount
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: business.rating,
          reviewCount: business.reviewCount,
        },
      }
    : {}),
};
---

<!doctype html>
<html lang="bg" style={themeStyle} data-style={style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="sitemap" href={withBase('/sitemap-index.xml')} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content={style === 'bold' ? '#07090d' : (theme?.dark ?? '#1f2328')} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={imageUrl(hero.image, 1200)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="bg_BG" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <!-- body stays transparent so the hero's fixed photo shows through; every section paints its own background -->
  <body class="min-h-dvh !bg-transparent pb-20 md:pb-0">
    {style === 'bold' && <Ambient scene={client.ambient ?? 'aurora'} />}
    <slot />
  </body>
</html>

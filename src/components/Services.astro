---
import type { Client } from '../lib/clients';
import { imageUrl, imageSrcset } from '../lib/clients';
const { client } = Astro.props as { client: Client };
---

<section id="uslugi" class="scroll-mt-20 bg-slab">
  <div class="container-site py-14 lg:py-20">
    <h2 class="text-2xl font-bold sm:text-3xl">С какво можем да помогнем</h2>

    <div class="mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2">
      {client.services.map((s) => (
        <article>
          <img
            src={imageUrl(s.image, 1024)}
            srcset={imageSrcset(s.image, [640, 1024])}
            sizes="(min-width: 640px) 50vw, 100vw"
            alt={s.imageAlt}
            width="1024"
            height="640"
            loading="lazy"
            decoding="async"
            class="aspect-[16/10] w-full rounded-ui object-cover"
          />
          <h3 class="mt-4 text-lg font-bold leading-snug">{s.title}</h3>
          <p class="mt-2 max-w-[48ch] text-[15px] leading-relaxed text-ink-soft">{s.text}</p>
        </article>
      ))}
    </div>

    <p class="mt-8 text-[15px] text-ink-soft">
      Не откривате вашия случай? Позвънете — ако не можем да помогнем, ще ви кажем откровено и ще ви насочим към колега.
    </p>
  </div>
</section>

---
import type { Client } from '../lib/clients';
import { telHref } from '../lib/clients';
const { client } = Astro.props as { client: Client };
const { business } = client;
const nav = [
  ['#uslugi', 'Услуги'],
  ['#kak-rabotim', 'Как работим'],
  ['#otzivi', 'Отзиви'],
  ['#kontakt', 'Контакт'],
];
---

<header class="bg-paper">
  <div class="container-site flex items-center justify-between gap-4 py-4">
    <a href="#top" class="min-w-0">
      <span class="block truncate font-display text-lg font-bold leading-tight text-graphite sm:text-xl">{business.name}</span>
      <span class="block truncate text-sm text-ink-soft">{business.trade}</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Основна навигация">
      {nav.map(([href, label]) => (
        <a href={href} class="text-[15px] font-medium text-ink hover:text-graphite">{label}</a>
      ))}
    </nav>

    <!-- Phones get an icon-only button (the sticky bar carries the words); wider screens show the number. -->
    <a href={telHref(business.phone)} class="btn-primary shrink-0 !px-3.5 sm:!px-5" aria-label={`Позвънете на ${business.phoneDisplay}`}>
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2z"/>
      </svg>
      <span class="hidden sm:inline">{business.phoneDisplay}</span>
    </a>
  </div>
</header>

---
import type { Client } from '../lib/clients';
import { googleReviewsHref, googleWriteReviewHref } from '../lib/clients';
const { client } = Astro.props as { client: Client };
const { reviews, business } = client;
const ratingText = business.rating?.toFixed(1).replace('.', ',');
const placeId = business.googlePlaceId;
const showRating = Boolean(business.rating && business.reviewCount);
---

<section id="otzivi" class="scroll-mt-20 bg-graphite text-white">
  <div class="container-site py-14 lg:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-2xl font-bold !text-white sm:text-3xl">Какво казват клиентите</h2>
      {showRating && (
        <p class="text-sm text-white/75">
          <span class="text-amber" aria-hidden="true">★★★★★</span>
          <strong class="ml-1 font-semibold text-white">{ratingText}</strong> · {business.reviewCount} отзива в Google
        </p>
      )}
    </div>

    <ul class="mt-8 grid gap-6 md:grid-cols-3">
      {reviews.items.map((r) => (
        <li class="flex flex-col rounded-ui border border-white/15 p-6">
          <blockquote class="grow text-[15px] leading-relaxed text-white/90">
            „{r.text}“
          </blockquote>
          <footer class="mt-5 text-sm text-white/70">
            <span class="font-semibold text-white">{r.name}</span>{r.when ? `, ${r.when}` : ''}
          </footer>
        </li>
      ))}
    </ul>

    {placeId && (
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={googleReviewsHref(placeId)} target="_blank" rel="noopener" class="btn-outline-light !min-h-11 text-sm">
          Всички отзиви в Google
        </a>
        <a href={googleWriteReviewHref(placeId)} target="_blank" rel="noopener" class="btn-outline-light !min-h-11 text-sm">
          Оставете отзив
        </a>
      </div>
    )}

    {reviews.sample && (
      <p class="mt-6 text-xs text-white/50">Примерни отзиви. Заменят се с реалните от Google профила на фирмата.</p>
    )}
  </div>
</section>

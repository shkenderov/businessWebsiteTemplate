---
import type { Client } from '../lib/clients';
import { imageUrl, imageSrcset } from '../lib/clients';
const { client } = Astro.props as { client: Client };
const g = client.gallery!;
const { business } = client;
---

<section id="galeria" class="scroll-mt-20 bg-paper">
  <div class="container-site py-14 lg:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">{g.title ?? 'Нашата работа'}</h2>
        {g.intro && <p class="mt-3 max-w-[56ch] text-[15px] leading-relaxed text-ink-soft">{g.intro}</p>}
      </div>
      {business.instagram && (
        <a href={business.instagram} target="_blank" rel="noopener" class="text-[15px] font-medium underline-offset-4 hover:underline">Още в Instagram</a>
      )}
    </div>

    <!-- a tight photo grid; the first image is larger because the first impression counts -->
    <ul class="mt-8 grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-3 lg:grid-cols-4">
      {g.images.map((img, i) => (
        <li class:list={[i === 0 && 'col-span-2 row-span-2']}>
          <img
            src={imageUrl(img.src, i === 0 ? 1200 : 640)}
            srcset={imageSrcset(img.src, i === 0 ? [800, 1200] : [400, 640])}
            sizes={i === 0 ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, 50vw'}
            alt={img.alt}
            width="640"
            height="640"
            loading="lazy"
            decoding="async"
            class="aspect-square h-full w-full rounded-ui object-cover"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

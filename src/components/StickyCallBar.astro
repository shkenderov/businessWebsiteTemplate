---
import type { Client } from '../lib/clients';
import { telHref, requestHref, requestLabel } from '../lib/clients';
const { client } = Astro.props as { client: Client };
const { business, hero } = client;
---

<!-- Mobile only: the two things a visitor on a phone wants are always one tap away. -->
<div class="callbar fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-slab-dark bg-paper/95 p-2 backdrop-blur md:hidden" style="padding-bottom: calc(0.5rem + env(safe-area-inset-bottom))">
  <a href={telHref(business.phone)} class="btn-primary !min-h-12 text-[15px]">
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2z"/>
    </svg>
    {hero.ctaCall ?? 'Позвънете'}
  </a>
  <a href={requestHref(client)} class="btn-outline-dark !min-h-12 text-[15px]">{requestLabel(client)}</a>
</div>

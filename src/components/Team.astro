---
import type { Client } from '../lib/clients';
import { imageUrl } from '../lib/clients';
const { client } = Astro.props as { client: Client };
const t = client.team!;
---

<section id="ekip" class="scroll-mt-20 bg-slab">
  <div class="container-site py-14 lg:py-20">
    <h2 class="text-2xl font-bold sm:text-3xl">{t.title ?? 'Екипът'}</h2>
    {t.intro && <p class="mt-3 max-w-[56ch] text-[15px] leading-relaxed text-ink-soft">{t.intro}</p>}

    <ul class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {t.members.map((m) => (
        <li class="flex gap-4">
          {m.image ? (
            <img src={imageUrl(m.image, 320)} alt={m.name} width="96" height="96" loading="lazy" decoding="async" class="size-24 shrink-0 rounded-full object-cover" />
          ) : (
            <span class="flex size-24 shrink-0 items-center justify-center rounded-full bg-graphite font-display text-2xl font-bold text-white" aria-hidden="true">{m.name.slice(0, 1)}</span>
          )}
          <div class="pt-2">
            <h3 class="text-lg font-bold leading-snug">{m.name}</h3>
            <p class="text-[15px] text-ink-soft">{m.role}</p>
            {m.note && <p class="mt-1.5 text-[15px] leading-relaxed">{m.note}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

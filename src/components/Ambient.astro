---
/**
 * The bold look's living background. Two fixed canvases behind the page:
 * a soft colour field, and a scene chosen per business (see scripts/ambient.ts).
 */
import type { SceneName } from '../scripts/ambient';
const { scene = 'aurora' } = Astro.props as { scene?: SceneName };
---

<div class="ambient" aria-hidden="true" data-scene={scene}>
  <canvas id="ambient-field"></canvas>
  {scene !== 'aurora' && <canvas id="ambient-scene"></canvas>}
</div>

<script>
  import { startAmbient } from '../scripts/ambient';
  import type { SceneName } from '../scripts/ambient';
  const root = document.querySelector<HTMLElement>('.ambient');
  const field = document.getElementById('ambient-field') as HTMLCanvasElement | null;
  const scene = document.getElementById('ambient-scene') as HTMLCanvasElement | null;
  if (root && field) startAmbient(field, scene, (root.dataset.scene as SceneName) || 'aurora');
</script>

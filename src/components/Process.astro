---
import type { Client } from '../lib/clients';
import { telHref } from '../lib/clients';
const { client } = Astro.props as { client: Client };
const { business } = client;
---

<section id="kak-rabotim" class="scroll-mt-20 bg-paper">
  <div class="container-site py-14 lg:py-20">
    <div class="lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">Как работим</h2>
        <p class="mt-3 max-w-[40ch] text-[15px] leading-relaxed text-ink-soft">
          Три стъпки, без изненади по пътя. {business.yearsExperience ? `${business.yearsExperience} години правим точно това.` : ''}
        </p>
        <a href={telHref(business.phone)} class="btn-outline-dark mt-6 hidden lg:inline-flex">
          Обадете се: {business.phoneDisplay}
        </a>
      </div>

      <!-- the steps really are a sequence, so they are numbered -->
      <ol class="mt-8 space-y-6 lg:mt-0">
        {client.process.map((step, i) => (
          <li class="flex gap-5">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-graphite font-display text-sm font-bold text-white" aria-hidden="true">{i + 1}</span>
            <div class="pt-1.5">
              <h3 class="text-lg font-bold leading-snug">{step.title}</h3>
              <p class="mt-1.5 text-[15px] leading-relaxed text-ink-soft">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

---
import type { Client } from '../lib/clients';
import { imageUrl, imageSrcset, telHref, requestHref, requestLabel } from '../lib/clients';
const { client } = Astro.props as { client: Client };
const { hero, business } = client;
const ratingText = business.rating?.toFixed(1).replace('.', ',');
const showRating = Boolean(business.rating && business.reviewCount);
const posDesktop = hero.imagePosition ?? '50% 50%';
const posMobile = hero.imagePositionMobile ?? posDesktop;
const reqHref = requestHref(client);
const reqLabel = requestLabel(client);
---

<!--
  The photo is a fixed layer behind the page: it stays put while the sections
  below (all with opaque backgrounds) scroll up over it. Done with a fixed
  element rather than background-attachment, because iOS ignores the latter.
-->
<section id="top" class="relative flex min-h-[82svh] flex-col justify-end text-white lg:min-h-[680px] lg:justify-center">
  <div class="fixed inset-0 -z-10" aria-hidden="true">
    <img
      src={imageUrl(hero.image, 1920)}
      srcset={imageSrcset(hero.image, [768, 1280, 1920])}
      sizes="100vw"
      alt=""
      width="1920"
      height="1280"
      fetchpriority="high"
      decoding="async"
      class="hero-photo h-full w-full object-cover"
    />
    <!-- legibility, layer 1: darken the whole photo a little, then heavily on the text side -->
    <div class="absolute inset-0 bg-graphite/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-graphite via-graphite/80 to-graphite/20 lg:bg-gradient-to-r lg:from-graphite/95 lg:via-graphite/80 lg:via-55% lg:to-graphite/10"></div>
  </div>

  <div class="container-site pb-24 pt-10 sm:pb-28 lg:py-28">
    <!-- legibility, layer 2: a near-solid panel behind the text, so contrast never depends on the photo -->
    <div class="-mx-4 max-w-[40rem] rounded-ui bg-graphite/75 px-4 py-6 sm:mx-0 sm:px-7 sm:py-8 lg:bg-graphite/70">
      <h1 class="max-w-[24ch] text-[1.9rem] font-bold leading-[1.1] !text-white sm:text-4xl lg:text-[2.75rem] lg:leading-[1.08]">
        {hero.headline}
      </h1>
      <p class="mt-5 max-w-[52ch] text-base leading-relaxed text-white/90 sm:text-lg">
        {hero.subline}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={telHref(business.phone)} class="btn-primary whitespace-nowrap">
          {hero.ctaCall ?? 'Позвънете'}: {business.phoneDisplay}
        </a>
        <!-- on phones the sticky bar already offers this, so it is not repeated here -->
        <a href={reqHref} class="btn-outline-light hidden whitespace-nowrap sm:inline-flex">{reqLabel}</a>
      </div>

      {showRating && (
        <p class="mt-8 flex items-center gap-2 text-sm text-white/85">
          <span class="flex text-amber" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg class="size-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9l-5.2 2.8 1-5.9L1.5 7.7l5.9-.8z"/></svg>
            ))}
          </span>
          <span><strong class="font-semibold text-white">{ratingText}</strong> от {business.reviewCount} отзива в Google</span>
        </p>
      )}
    </div>
  </div>

  <!-- the roof line: one pitched edge, used once -->
  <svg class="absolute bottom-0 left-0 h-8 w-full text-paper sm:h-12 lg:h-16" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
    <polygon points="0,10 100,0 100,10" fill="currentColor" />
  </svg>
</section>

<style define:vars={{ posDesktop, posMobile }}>
  .hero-photo {
    object-position: var(--posMobile);
  }
  @media (min-width: 64rem) {
    .hero-photo {
      object-position: var(--posDesktop);
    }
  }
</style>

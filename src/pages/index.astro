---
import '../styles/global.css';
import { loadClients, withBase, imageUrl } from '../lib/clients';
import Ambient from '../components/Ambient.astro';

// The showcase: every pack in both looks. Fictional businesses, not indexed.
const clients = loadClients();
const packs = [
  { slug: 'auto', label: 'Автосервиз и гуми' },
  { slug: 'barber', label: 'Бръснарница' },
  { slug: 'salon', label: 'Фризьорски салон' },
  { slug: 'phone-repair', label: 'Ремонт на телефони' },
  { slug: 'roofer', label: 'Ремонт на покриви' },
  { slug: 'hvac', label: 'Климатици' },
].map((p) => ({
  ...p,
  bold: clients.find((c) => c.slug === p.slug),
  calm: clients.find((c) => c.slug === `${p.slug}-calm`),
}));
---

<!doctype html>
<html lang="bg" data-style="bold" style="--color-on-accent:#10131a">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Примерни сайтове за малки фирми</title>
    <meta name="description" content="Шест вида местен бизнес, два стила. Примерни сайтове с измислени фирми." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body class="min-h-dvh !bg-transparent text-ink">
    <Ambient />
    <main class="container-site py-12 lg:py-20">
      <h1 class="max-w-[22ch] text-3xl font-bold !text-white sm:text-4xl">Примерни сайтове за малки фирми</h1>
      <p class="mt-4 max-w-[60ch] text-[15px] leading-relaxed text-ink-soft">
        Шест вида бизнес, всеки в два стила. Фирмите са измислени; снимките, цените и отзивите се подменят с вашите.
        Отворете от телефона — така ще го видят и клиентите ви.
      </p>

      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {packs.map((p) => (
          <li class="surface overflow-hidden">
            {p.bold && (
              <img src={imageUrl(p.bold.hero.image, 800)} alt="" width="800" height="500" loading="lazy" class="aspect-[16/10] w-full object-cover" />
            )}
            <div class="p-5">
              <h2 class="text-lg font-bold">{p.label}</h2>
              <div class="mt-3 flex flex-wrap gap-2">
                {p.bold && <a href={withBase(`/${p.slug}/`)} class="btn-primary !min-h-10 !px-4 text-sm">Ярък стил</a>}
                {p.calm && <a href={withBase(`/${p.slug}-calm/`)} class="btn-outline-light !min-h-10 !px-4 text-sm">Спокоен стил</a>}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
